{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "recruiting-decision-coordinator",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-24",
  "vars": {
    "OPENAI_BASE_URL": "https://aigw.asiainfo.com/v1",
    "ENTERPRISE_MODEL": "wangsu/gpt-5.5",
    "ANTHROPIC_BASE_URL": "https://aigw.asiainfo.com"
  },
  "assets": {
    "directory": "./ui",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
